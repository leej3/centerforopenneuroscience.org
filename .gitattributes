
* annex.backend=MD5E
**/.git* annex.largefiles=nothing
* annex.largefiles=((mimeencoding=binary)and(largerthan=0))

# Keep the small, pre-existing logo blobs in Git. Other binary site assets use
# the repository's default git-annex policy above.
assets/img/con-logo.png annex.largefiles=nothing
assets/img/con-logo.svg annex.largefiles=nothing
assets/img/datalad-logo.png annex.largefiles=nothing
metadata/schema/** annex.largefiles=nothing
metadata/schema/demo-research-information.static.yaml whitespace=-blank-at-eof
provenance/legacy/** annex.largefiles=nothing
provenance/legacy/html/** whitespace=-trailing-space,-space-before-tab
static/** annex.largefiles=nothing
